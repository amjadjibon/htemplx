package components

// Toggle renders a toggle button
templ Toggle(text string, pressed bool, variant string, size string, attrs ...templ.Attributes) {
	<button
		type="button"
		aria-pressed={ getBoolString(pressed) }
		data-state={ getToggleState(pressed) }
		class={ getToggleClasses(variant, size, pressed) }
		_={ getToggleScript() }
		{ attrs... }
	>
		{ text }
	</button>
}

// ToggleWithIcon renders a toggle button with icon
templ ToggleWithIcon(icon templ.Component, pressed bool, variant string, size string, attrs ...templ.Attributes) {
	<button
		type="button"
		aria-pressed={ getBoolString(pressed) }
		data-state={ getToggleState(pressed) }
		class={ getToggleClasses(variant, size, pressed) }
		_={ getToggleScript() }
		{ attrs... }
	>
		@icon
	</button>
}

// ToggleGroup renders a group of toggle buttons
templ ToggleGroup(items []ToggleItem, variant string, size string) {
	<div class="inline-flex rounded-md shadow-sm" role="group">
		for i, item := range items {
			<button
				type="button"
				aria-pressed={ getBoolString(item.Pressed) }
				data-state={ getToggleState(item.Pressed) }
				class={ getToggleGroupItemClasses(variant, size, item.Pressed, i == 0, i == len(items)-1) }
				_={ getToggleScript() }
			>
				{ item.Text }
			</button>
		}
	</div>
}

// ToggleItem represents a toggle button in a group
type ToggleItem struct {
	Text    string
	Pressed bool
	Value   string
}

func getToggleState(pressed bool) string {
	if pressed {
		return "on"
	}
	return "off"
}

func getToggleClasses(variant string, size string, pressed bool) string {
	baseClasses := "inline-flex items-center justify-center rounded-md font-medium ring-offset-white transition-colors hover:bg-slate-100 hover:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 dark:ring-offset-slate-950 dark:hover:bg-slate-800 dark:hover:text-slate-400 dark:focus-visible:ring-slate-300"

	var variantClasses string
	if pressed {
		switch variant {
		case "outline":
			variantClasses = "border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-800"
		default:
			variantClasses = "bg-slate-100 dark:bg-slate-800"
		}
	} else {
		switch variant {
		case "outline":
			variantClasses = "border border-slate-200 bg-transparent hover:bg-slate-100 dark:border-slate-800 dark:hover:bg-slate-800"
		default:
			variantClasses = "bg-transparent"
		}
	}

	var sizeClasses string
	switch size {
	case "sm":
		sizeClasses = "h-9 px-2.5 text-xs"
	case "lg":
		sizeClasses = "h-11 px-5"
	default:
		sizeClasses = "h-10 px-3"
	}

	return baseClasses + " " + variantClasses + " " + sizeClasses
}

func getToggleGroupItemClasses(variant string, size string, pressed bool, isFirst bool, isLast bool) string {
	baseClasses := "inline-flex items-center justify-center font-medium ring-offset-white transition-colors hover:bg-slate-100 hover:text-slate-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-950 focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 dark:ring-offset-slate-950 dark:hover:bg-slate-800 dark:hover:text-slate-400 dark:focus-visible:ring-slate-300"

	roundClasses := ""
	if isFirst {
		roundClasses = "rounded-l-md"
	}
	if isLast {
		roundClasses += " rounded-r-md"
	}
	if !isFirst {
		roundClasses += " border-l-0"
	}

	var variantClasses string
	if pressed {
		variantClasses = "border border-slate-200 bg-slate-100 dark:border-slate-800 dark:bg-slate-800"
	} else {
		variantClasses = "border border-slate-200 bg-transparent dark:border-slate-800"
	}

	var sizeClasses string
	switch size {
	case "sm":
		sizeClasses = "h-9 px-2.5 text-xs"
	case "lg":
		sizeClasses = "h-11 px-5"
	default:
		sizeClasses = "h-10 px-3"
	}

	return baseClasses + " " + variantClasses + " " + sizeClasses + " " + roundClasses
}

func getToggleScript() string {
	return `on click
		if @data-state is 'on'
			set @data-state to 'off'
			set @aria-pressed to 'false'
		else
			set @data-state to 'on'
			set @aria-pressed to 'true'
		end`
}
