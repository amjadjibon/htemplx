package components

// Alert2 variants: default, destructive, success, warning, info
// Note: Named Alert2 to avoid conflict with existing alert.templ

// Alert2 renders an alert component
templ Alert2(title string, description string, variant string) {
	<div class={ getAlert2Classes(variant) } role="alert">
		<div class="flex gap-3">
			@Alert2Icon(variant)
			<div class="flex-1">
				if title != "" {
					<h5 class="mb-1 font-medium leading-none tracking-tight">
						{ title }
					</h5>
				}
				if description != "" {
					<div class="text-sm opacity-90">
						{ description }
					</div>
				}
			</div>
		</div>
	</div>
}

// Alert2Simple renders a simple alert with just description
templ Alert2Simple(description string, variant string) {
	@Alert2("", description, variant)
}

// Alert2WithAction renders an alert with an action button
templ Alert2WithAction(title string, description string, variant string, actionText string, actionAttrs ...templ.Attributes) {
	<div class={ getAlert2Classes(variant) } role="alert">
		<div class="flex items-start gap-3">
			@Alert2Icon(variant)
			<div class="flex-1">
				if title != "" {
					<h5 class="mb-1 font-medium leading-none tracking-tight">
						{ title }
					</h5>
				}
				if description != "" {
					<div class="text-sm opacity-90">
						{ description }
					</div>
				}
			</div>
			if actionText != "" {
				<button class="rounded-md px-3 py-1.5 text-sm font-medium hover:bg-black/10 dark:hover:bg-white/10" { actionAttrs... }>
					{ actionText }
				</button>
			}
		</div>
	</div>
}

// Alert2Icon renders the appropriate icon for each alert variant
templ Alert2Icon(variant string) {
	switch variant {
		case "destructive":
			<svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
			</svg>
		case "success":
			<svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
			</svg>
		case "warning":
			<svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
			</svg>
		case "info":
			<svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			</svg>
		default:
			<svg class="h-5 w-5 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			</svg>
	}
}

// getAlert2Classes returns the CSS classes for different alert variants
func getAlert2Classes(variant string) string {
	baseClasses := "relative w-full rounded-lg border p-4"

	var variantClasses string
	switch variant {
	case "destructive":
		variantClasses = "border-red-500/50 bg-red-50 text-red-900 dark:border-red-900/50 dark:bg-red-900/10 dark:text-red-400"
	case "success":
		variantClasses = "border-green-500/50 bg-green-50 text-green-900 dark:border-green-900/50 dark:bg-green-900/10 dark:text-green-400"
	case "warning":
		variantClasses = "border-yellow-500/50 bg-yellow-50 text-yellow-900 dark:border-yellow-900/50 dark:bg-yellow-900/10 dark:text-yellow-400"
	case "info":
		variantClasses = "border-blue-500/50 bg-blue-50 text-blue-900 dark:border-blue-900/50 dark:bg-blue-900/10 dark:text-blue-400"
	default:
		variantClasses = "bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-50 border-slate-200 dark:border-slate-800"
	}

	return baseClasses + " " + variantClasses
}
