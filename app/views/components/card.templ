package components

// Card renders a basic card container
templ Card(children ...templ.Component) {
	<div class="rounded-lg border border-slate-200 bg-white text-slate-950 shadow-sm dark:border-slate-800 dark:bg-slate-950 dark:text-slate-50">
		for _, child := range children {
			@child
		}
	</div>
}

// CardHeader renders the card header section
templ CardHeader(children ...templ.Component) {
	<div class="flex flex-col space-y-1.5 p-6">
		for _, child := range children {
			@child
		}
	</div>
}

// CardTitle renders the card title
templ CardTitle(title string) {
	<h3 class="text-2xl font-semibold leading-none tracking-tight">
		{ title }
	</h3>
}

// CardDescription renders the card description
templ CardDescription(description string) {
	<p class="text-sm text-slate-500 dark:text-slate-400">
		{ description }
	</p>
}

// CardContent renders the card content section
templ CardContent(children ...templ.Component) {
	<div class="p-6 pt-0">
		for _, child := range children {
			@child
		}
	</div>
}

// CardFooter renders the card footer section
templ CardFooter(children ...templ.Component) {
	<div class="flex items-center p-6 pt-0">
		for _, child := range children {
			@child
		}
	</div>
}

// CardSimple renders a simple card with title, description, and content
templ CardSimple(title string, description string, content templ.Component) {
	@Card(
		CardHeader(
			CardTitle(title),
			CardDescription(description),
		),
		CardContent(content),
	)
}

// CardWithFooter renders a card with title, description, content, and footer
templ CardWithFooter(title string, description string, content templ.Component, footer templ.Component) {
	@Card(
		CardHeader(
			CardTitle(title),
			CardDescription(description),
		),
		CardContent(content),
		CardFooter(footer),
	)
}
