package components

// Collapsible renders a collapsible section
templ Collapsible(id string, trigger templ.Component, content templ.Component, open bool) {
	<div class="space-y-2">
		<div _={ "on click toggle .hidden on #" + id + "-content" }>
			@trigger
		</div>
		<div id={ id + "-content" } class={ getCollapsibleContentClasses(open) }>
			@content
		</div>
	</div>
}

// CollapsibleWithTitle renders a collapsible with a title trigger
templ CollapsibleWithTitle(id string, title string, content templ.Component, open bool) {
	<div class="space-y-2">
		<button
			type="button"
			class="flex w-full items-center justify-between rounded-md px-4 py-2 text-left text-sm font-medium hover:bg-slate-100 dark:hover:bg-slate-800"
			_={ "on click toggle .hidden on #" + id + "-content then toggle .rotate-180 on #" + id + "-icon" }
		>
			<span>{ title }</span>
			<svg
				id={ id + "-icon" }
				class={ getIconClasses(open) }
				width="15"
				height="15"
				viewBox="0 0 15 15"
				fill="none"
			>
				<path
					d="M3.13523 6.15803C3.3241 5.95657 3.64052 5.94637 3.84197 6.13523L7.5 9.56464L11.158 6.13523C11.3595 5.94637 11.6759 5.95657 11.8648 6.15803C12.0536 6.35949 12.0434 6.67591 11.842 6.86477L7.84197 10.6148C7.64964 10.7951 7.35036 10.7951 7.15803 10.6148L3.15803 6.86477C2.95657 6.67591 2.94637 6.35949 3.13523 6.15803Z"
					fill="currentColor"
					fill-rule="evenodd"
					clip-rule="evenodd"
				></path>
			</svg>
		</button>
		<div id={ id + "-content" } class={ getCollapsibleContentClasses(open) }>
			@content
		</div>
	</div>
}

func getCollapsibleContentClasses(open bool) string {
	if open {
		return ""
	}
	return "hidden"
}

func getIconClasses(open bool) string {
	baseClasses := "transition-transform duration-200"
	if open {
		return baseClasses + " rotate-180"
	}
	return baseClasses
}
