package components

// Toast variants: default, success, error, warning, info

// Toast renders a toast notification
// Use with HTMX: hx-swap-oob="beforeend:#toast-container"
templ Toast(id string, title string, description string, variant string) {
	<div
		id={ id }
		class={ getToastClasses(variant) }
		role="alert"
		_="on load wait 5s then add .opacity-0 then wait 300ms then remove me"
	>
		<div class="flex items-start gap-3">
			<!-- Icon -->
			<div class="flex-shrink-0">
				@ToastIcon(variant)
			</div>
			<!-- Content -->
			<div class="flex-1 space-y-1">
				<p class="text-sm font-semibold">
					{ title }
				</p>
				if description != "" {
					<p class="text-sm opacity-90">
						{ description }
					</p>
				}
			</div>
			<!-- Close button -->
			<button
				type="button"
				class="flex-shrink-0 rounded-md opacity-70 hover:opacity-100 focus:outline-none focus:ring-2 focus:ring-offset-2"
				_="on click add .opacity-0 to #{ id } then wait 300ms then remove #{ id }"
			>
				<span class="sr-only">Close</span>
				<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
					<path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
				</svg>
			</button>
		</div>
	</div>
}

// ToastSimple renders a simple toast with just a message
templ ToastSimple(id string, message string, variant string) {
	@Toast(id, message, "", variant)
}

// ToastContainer should be added to your layout/base template
templ ToastContainer() {
	<div
		id="toast-container"
		class="fixed top-0 right-0 z-50 p-4 space-y-4 w-full max-w-sm"
		aria-live="polite"
	></div>
}

// ToastIcon renders the appropriate icon for each toast variant
templ ToastIcon(variant string) {
	switch variant {
		case "success":
			<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
			</svg>
		case "error":
			<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
			</svg>
		case "warning":
			<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
			</svg>
		case "info":
			<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			</svg>
		default:
			<svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
			</svg>
	}
}

// getToastClasses returns the CSS classes for different toast variants
func getToastClasses(variant string) string {
	baseClasses := "pointer-events-auto w-full max-w-sm overflow-hidden rounded-lg shadow-lg ring-1 ring-black ring-opacity-5 transition-opacity duration-300"

	var variantClasses string
	switch variant {
	case "success":
		variantClasses = "bg-green-50 text-green-900 dark:bg-green-900 dark:text-green-50"
	case "error":
		variantClasses = "bg-red-50 text-red-900 dark:bg-red-900 dark:text-red-50"
	case "warning":
		variantClasses = "bg-yellow-50 text-yellow-900 dark:bg-yellow-900 dark:text-yellow-50"
	case "info":
		variantClasses = "bg-blue-50 text-blue-900 dark:bg-blue-900 dark:text-blue-50"
	default:
		variantClasses = "bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-50"
	}

	return baseClasses + " " + variantClasses + " p-4"
}
