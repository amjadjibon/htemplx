package components

// Dialog renders a modal dialog with HTMX support
// Use with: hx-get, hx-post, hx-target="#dialog-container"
templ Dialog(id string, title string, description string, content templ.Component, footer templ.Component) {
	<div id={ id } class="relative z-50" aria-labelledby="modal-title" role="dialog" aria-modal="true">
		<!-- Background backdrop -->
		<div class="fixed inset-0 bg-slate-900/80 backdrop-blur-sm transition-opacity"></div>
		<!-- Dialog container -->
		<div class="fixed inset-0 z-50 overflow-y-auto">
			<div class="flex min-h-full items-center justify-center p-4 text-center sm:p-0">
				<!-- Dialog panel -->
				<div
					class="relative transform overflow-hidden rounded-lg border border-slate-200 bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg dark:border-slate-800 dark:bg-slate-950"
					_="on click outside hide #{ id } then remove #{ id }"
				>
					<!-- Dialog header -->
					<div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4 dark:bg-slate-950">
						<div class="flex items-start">
							<div class="mt-3 text-center sm:ml-0 sm:mt-0 sm:text-left w-full">
								<h3 class="text-lg font-semibold leading-6 text-slate-900 dark:text-slate-50" id="modal-title">
									{ title }
								</h3>
								if description != "" {
									<p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
										{ description }
									</p>
								}
								<!-- Dialog content -->
								<div class="mt-4">
									@content
								</div>
							</div>
							<!-- Close button -->
							<button
								type="button"
								class="rounded-md text-slate-400 hover:text-slate-500 focus:outline-none dark:hover:text-slate-300"
								_="on click hide #{ id } then remove #{ id }"
							>
								<span class="sr-only">Close</span>
								<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
								</svg>
							</button>
						</div>
					</div>
					<!-- Dialog footer -->
					if footer != nil {
						<div class="bg-slate-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2 dark:bg-slate-900">
							@footer
						</div>
					}
				</div>
			</div>
		</div>
	</div>
}

// DialogSimple renders a simple dialog with just content
templ DialogSimple(id string, title string, content templ.Component) {
	@Dialog(id, title, "", content, nil)
}

// DialogConfirm renders a confirmation dialog
templ DialogConfirm(id string, title string, description string, confirmText string, cancelText string, confirmAction string) {
	@Dialog(
		id,
		title,
		description,
		nil,
		DialogConfirmFooter(id, confirmText, cancelText, confirmAction),
	)
}

// DialogConfirmFooter renders the footer for confirmation dialogs
templ DialogConfirmFooter(id string, confirmText string, cancelText string, confirmAction string) {
	<button
		type="button"
		class="inline-flex w-full justify-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500 sm:w-auto"
		hx-post={ confirmAction }
		hx-swap="outerHTML"
		_={ "on htmx:afterRequest hide #" + id + " then remove #" + id }
	>
		{ confirmText }
	</button>
	<button
		type="button"
		class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-900 shadow-sm ring-1 ring-inset ring-slate-300 hover:bg-slate-50 sm:mt-0 sm:w-auto dark:bg-slate-950 dark:text-slate-50 dark:ring-slate-700 dark:hover:bg-slate-900"
		_={ "on click hide #" + id + " then remove #" + id }
	>
		{ cancelText }
	</button>
}

// AlertDialog renders an alert dialog with a single action button
templ AlertDialog(id string, title string, description string, actionText string) {
	@Dialog(
		id,
		title,
		description,
		nil,
		AlertDialogFooter(id, actionText),
	)
}

// AlertDialogFooter renders the footer for alert dialogs
templ AlertDialogFooter(id string, actionText string) {
	<button
		type="button"
		class="inline-flex w-full justify-center rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-slate-800 sm:w-auto dark:bg-slate-50 dark:text-slate-900 dark:hover:bg-slate-200"
		_={ "on click hide #" + id + " then remove #" + id }
	>
		{ actionText }
	</button>
}
